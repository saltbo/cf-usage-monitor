{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "types": [
      "./worker-configuration.d.ts",
      "@cloudflare/vitest-pool-workers",
      "@cloudflare/vitest-pool-workers/types"
    ],
    "skipLibCheck": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo"
  },
  "include": [
    "worker/**/*.ts",
    "src/*.ts",
    "src/server/**/*.ts",
    "src/shared/**/*.ts",
    "test/**/*.ts",
    "vitest.worker.config.ts"
  ]
}
