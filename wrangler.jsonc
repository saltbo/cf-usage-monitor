{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-usage-monitor",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "triggers": {
    "crons": ["5,15,25,35,45,55 * * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "STATE",
      "id": "e8c6085c6eac4cd2b34b7d64c8b7bcd1"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "vars": {
    "CF_ACCOUNT_ID": "94a89d03c0fc785c8dcbd3c674d6742a",
    "ALERT_AFTER_SAMPLES": "2",
    "RECOVERY_SAMPLES": "3",
    "REMINDER_MINUTES": "60",
    "USAGE_ALERT_POLICIES": {
      "r2.storage_gb_month": "track_only"
    },
  },
  "secrets": {
    "required": [
      "CF_API_TOKEN",
      "ALERT_WEBHOOK_URL",
      "ALERT_EMAIL_FROM",
      "ALERT_EMAIL_TO",
      "DASHBOARD_PASSWORD"
    ]
  }
}
