{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-usage-monitor",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "triggers": {
    "crons": ["5,15,25,35,45,55 * * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "STATE",
      "id": "e8c6085c6eac4cd2b34b7d64c8b7bcd1"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "vars": {
    "CF_ACCOUNT_ID": "94a89d03c0fc785c8dcbd3c674d6742a",
    "ACCOUNT_NAME": "primary",
    "ALERT_AFTER_SAMPLES": "2",
    "RECOVERY_SAMPLES": "3",
    "REMINDER_MINUTES": "60",
    "D1_DATABASE_NAMES": {
      "ec2cf4d8-ce8e-4dcf-bd7f-71973df5f5a3": "sublyra-appbase",
      "be751858-3f8f-4783-aee6-db2cfe33fb31": "zme",
      "4aad3c2f-4ec4-4b0e-a9ed-b0696e4da76f": "flareauth-tftt",
      "104db330-89c5-443c-be04-7554ac958712": "sink",
      "1b821d59-c74b-47e4-9af3-3d83de81dc1c": "any-managed-agents-db",
      "8a30ad06-ace4-4cf7-a70d-61adc0e3e042": "any-managed-agents-db-staging",
      "4214d8e8-6e05-40c2-ba56-80e5c5ba965a": "flareauth-db",
      "a6aa476d-5866-4911-b8ff-b95fb1ace362": "flareauth-db-staging",
      "60b02643-3963-4b29-9f6e-d4b521243d3f": "zpan-cloud",
      "9a5f86ec-8830-478f-bfd2-fe7bc3de2d66": "zpan-cloud-staging",
      "a9197d7a-6524-42f0-b646-e714dcb30b3b": "zpan-db-preview",
      "5bd64957-fa49-4da0-8b7b-6e0ad84037e7": "zpan-db",
      "4f6a9625-6638-4d13-badb-55d40b836c9d": "wakatoken-db",
      "56c34918-779d-4c93-b9a7-6f99b73733c4": "mails",
      "d12fc329-6105-437c-9580-bab26891b059": "agent-kanban-db-preview",
      "13cdf435-a99c-4744-9eca-9ed22b232581": "agent-kanban-db",
      "9247858f-85a8-4106-825f-a3e7f85a51f7": "uptimer",
      "74d7ccea-5857-4d90-adfd-fe121fc6479c": "test"
    }
  },
  "secrets": {
    "required": [
      "CF_API_TOKEN",
      "ALERT_WEBHOOK_URL",
      "ALERT_EMAIL_FROM",
      "ALERT_EMAIL_TO",
      "DASHBOARD_PASSWORD"
    ]
  }
}
